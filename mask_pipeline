import os
import cv2
import numpy as np
from retinaface import RetinaFace
import tensorflow as tf
from tensorflow.keras.preprocessing.image import ImageDataGenerator
from tensorflow.keras.applications import MobileNetV2
from tensorflow.keras.models import Model
from tensorflow.keras.layers import Dense, GlobalAveragePooling2D, Dropout

def detect_face_retina(img_path):
    try:
        faces = RetinaFace.extract_faces(img_path=img_path, align=True)
        return faces[0] if faces else None
    except Exception as e:
        print("Face detection error:", e)
        return None

def preprocess_retina_image(img_path, target_size=(224, 224)):
    face = detect_face_retina(img_path)
    if face is None:
        return None
    face = cv2.resize(face, target_size)
    face = face / 255.0
    face = np.expand_dims(face, axis=0)
    return face

def predict_mask_retina(model, img_path):
    input_img = preprocess_retina_image(img_path)
    if input_img is None:
        return "No face detected"
    prediction = model.predict(input_img)
    return "Mask" if prediction[0][0] > 0.5 else "No Mask"

def create_generators():
    datagen = ImageDataGenerator(
        rescale=1./255,
        rotation_range=15,
        width_shift_range=0.1,
        height_shift_range=0.1,
        brightness_range=[0.7, 1.3],
        zoom_range=0.2,
        horizontal_flip=True,
        validation_split=0.2
    )

    train_gen = datagen.flow_from_directory(
        'dataset/mask',  
        target_size=(224, 224),
        batch_size=32,
        class_mode='binary',
        subset='training'
    )

    val_gen = datagen.flow_from_directory(
        'dataset/mask',
        target_size=(224, 224),
        batch_size=32,
        class_mode='binary',
        subset='validation'
    )

    return train_gen, val_gen

def build_model():
    base = MobileNetV2(weights='imagenet', include_top=False, input_shape=(224,224,3))
    x = GlobalAveragePooling2D()(base.output)
    x = Dropout(0.3)(x)
    output = Dense(1, activation='sigmoid')(x)
    model = Model(inputs=base.input, outputs=output)

    for layer in base.layers:
        layer.trainable = False

    model.compile(optimizer='adam', loss='binary_crossentropy', metrics=['accuracy'])
    return model

def train_model():
    train_gen, val_gen = create_generators()
    model = build_model()
    model.fit(train_gen, validation_data=val_gen, epochs=10)
    model.save("models/improved_mask_detector.h5")
    return model

if __name__ == "__main__":
    retrain = True

    if retrain:
        model = train_model()
    else:
        model = tf.keras.models.load_model("models/improved_mask_detector.h5")

    test_image_path = r"C:\Users\Mallipudi.Susi\Desktop\hackathon\36_1_1_20170117170752063.jpg.jpg"
    result = predict_mask_retina(model, test_image_path)
    print("Prediction:", result)
